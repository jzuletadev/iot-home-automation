# Copiar como secrets.yaml y rellenar. secrets.yaml esta en .gitignore.
#
# En el Raspberry Pi este archivo vive en /config/esphome/secrets.yaml y se
# edita desde ESPHome Builder (icono de llave en la esquina superior derecha).

wifi_ssid: "NOMBRE_DE_TU_RED"
wifi_password: "PASSWORD_DE_TU_RED"

# Password del AP de rescate que levanta el nodo si no logra conectarse.
fallback_password: "cambiar-esto"

# Password para actualizaciones OTA. Igual para todos los nodos.
ota_password: "cambiar-esto"

# Clave de cifrado de la API nativa. Generar una en:
#   https://esphome.io/components/api.html  (boton "generate a key")
# Es base64 de 32 bytes.
api_encryption_key: "GENERAR_UNA_CLAVE_BASE64_DE_32_BYTES="
